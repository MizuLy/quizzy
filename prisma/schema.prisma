generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Topic {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  questions Question[]

  @@map("topics")
}

model Question {
  id          String      @id @default(uuid()) @db.Uuid
  text        String
  answer      String
  distractors String[]
  topicId     String   @db.Uuid

  topic       Topic    @relation(fields: [topicId], references: [id])

  @@index([topicId])
  @@map("questions")
}